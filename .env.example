EDGE_THRESHOLD=0.03
SENTIMENT_WEIGHT=0.20
ONCHAIN_WEIGHT=0.25
ORDERFLOW_WEIGHT=0.35
NEWS_WEIGHT=0.20
PRIOR_STRENGTH=0.55
