CONFIDENCE_ORDERFLOW_WEIGHT=0.30
CONFIDENCE_SOURCE_HEALTH_WEIGHT=0.25
MIN_SOURCE_HEALTH=0.34

# Quality guard tuning
QUALITY_WINDOW=50
QUALITY_MIN_HISTORY=10
QUALITY_IMPLIED_Z_THRESHOLD=4.0
QUALITY_SPREAD_Z_THRESHOLD=4.0
QUALITY_DEPTH_Z_THRESHOLD=4.5
