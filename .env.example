REGIME_MID_VOL_CONFIDENCE_MULTIPLIER=0.93
REGIME_LOW_VOL_RISK_MULTIPLIER=1.0
REGIME_LOW_VOL_CONFIDENCE_MULTIPLIER=1.0

# Tuning scoring
TUNING_WIN_RATE_BONUS=2000
TUNING_NO_TRADE_PENALTY=50
