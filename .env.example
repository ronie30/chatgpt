# API behavior
REQUEST_TIMEOUT_SEC=8

# Risk / strategy
MAX_POSITION_USD=250
MAX_PORTFOLIO_EXPOSURE=0.25
KELLY_FRACTION_CAP=0.25
MIN_CONFIDENCE=0.60
MAX_DRAWDOWN_STOP=0.10
MIN_EXPECTED_VALUE_BPS=40
